# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=5000

# MongoDB connection string (local install or Atlas)
MONGODB_URI=mongodb://localhost:27017/configsnapshot

# Required for securely persisted environment credentials. Use a random value
# of at least 32 characters and keep it stable between restarts.
CREDENTIAL_ENCRYPTION_KEY=replace_with_a_long_random_secret_at_least_32_chars

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Oracle Fusion Cloud base URL, no trailing slash
FUSION_BASE_URL=https://your-instance.oraclecloud.com

# Read-only / integration user credentials
FUSION_USERNAME=your_integration_user
FUSION_PASSWORD=your_password

# Comma-separated Inventory Organization codes to extract, or ALL
FUSION_ORG_CODES=ALL

# REST API page size (Fusion default max is usually 500)
PAGE_SIZE=500
MAX_PAGES=10000

# Functional Setup Manager task exports are asynchronous.
TASK_EXPORT_POLL_MS=5000
TASK_EXPORT_TIMEOUT_MS=600000
